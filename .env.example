# BhoomiSetu Environment Configuration Template
# Copy to .env.local to customize local development

# Optional Google Maps API Key for production cadastral inspection
# Note: Leaflet high-resolution Satellite & Cadastre fallback operates seamlessly without an API key
VITE_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# FastAPI Backend REST Gateway URL (Default local development)
NEXT_PUBLIC_API_URL=http://localhost:8000
